<UserControl x:Class="AdventurersGuild.UI.Views.Quests.QuestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:AdventurersGuild.ViewModels.Quests;assembly=AdventurersGuild.ViewModels"
             xmlns:converters="clr-namespace:AdventurersGuild.UI.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:QuestsViewModel}">

    <UserControl.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ContentGrid" TargetType="Grid">
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style x:Key="Toolbar" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        
        <Style x:Key="FilterPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FilterRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="FilterLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource ContentGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Квесты" Style="{StaticResource PageTitle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Style="{StaticResource FilterPanel}">
            <StackPanel Style="{StaticResource FilterRow}">
                <Label Content="Поиск:" Style="{StaticResource FilterLabel}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FilterTextBox}"
                         ToolTip="Поиск по названию и описанию" />
            </StackPanel>
            
            <StackPanel Style="{StaticResource FilterRow}">
                <Label Content="Статус:" Style="{StaticResource FilterLabel}" />
                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatusOption}"
                          Style="{StaticResource FilterComboBox}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value, Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            
            <StackPanel Style="{StaticResource FilterRow}">
                <Label Content="Исполнитель:" Style="{StaticResource FilterLabel}" />
                <ComboBox ItemsSource="{Binding AdventurerOptions}"
                          SelectedItem="{Binding SelectedAdventurerOption}"
                          Width="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <Binding Path="Value.Name" TargetNullValue="Все" FallbackValue="Все" />
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" Style="{StaticResource Toolbar}">
            <Button Content="Добавить" Command="{Binding AddCommand}" Style="{StaticResource ActionButton}" />
            <Button Content="Редактировать" Command="{Binding EditCommand}" Style="{StaticResource ActionButton}" />
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource ActionButton}" />
        </StackPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Quests}"
                  SelectedItem="{Binding SelectedQuest}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Награда" Binding="{Binding Reward}" Width="100" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource EnumDescriptionConverter}}" Width="120" />
                <DataGridTextColumn Header="Исполнитель" Width="150">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Adventurer.Name" 
                                 TargetNullValue="Не назначен" 
                                 FallbackValue="Не назначен" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
